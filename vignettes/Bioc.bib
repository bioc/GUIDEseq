@article{Zhu2010,
   author = {Zhu, L. J. and Gazin, C. and Lawson, N. D. and Pages, H. and Lin, S. M. and Lapointe, D. S. and Green, M. R.},
   title = {ChIPpeakAnno: a Bioconductor package to annotate ChIP-seq and ChIP-chip data},
   journal = {BMC Bioinformatics},
   volume = {11},
   pages = {237},
   note = {Zhu, Lihua J
Gazin, Claude
Lawson, Nathan D
Pages, Herve
Lin, Simon M
Lapointe, David S
Green, Michael R
eng
R01 GM033977/GM/NIGMS NIH HHS/
